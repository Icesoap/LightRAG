# BK100基线测试 - LightRAG配置示例
# 
# 使用说明:
# 1. 复制此文件到项目根目录的 .env
# 2. 修改相应的API密钥和配置
# 3. 运行测试: python lightrag/evaluation/run_bk100_baseline.py

# ============================================================================
# LLM配置（用于LightRAG生成答案）
# ============================================================================

# OpenAI配置（推荐）
LLM_BINDING=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here

# 如果使用自定义OpenAI兼容端点（如vLLM、Ollama等）
# LLM_BINDING_HOST=http://localhost:8000/v1
# LLM_BINDING_API_KEY=your-custom-api-key

# ============================================================================
# Embedding配置（用于向量检索）
# ============================================================================

# OpenAI Embedding（推荐）
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_API_KEY 已在上文设置

# 如果使用自定义embedding端点
# EMBEDDING_BINDING_HOST=http://localhost:8000/v1
# EMBEDDING_BINDING_API_KEY=your-custom-api-key

# ============================================================================
# 评估LLM配置（用于RAGAS评分）
# ============================================================================

# RAGAS评估使用的LLM（建议使用更强的模型）
EVAL_LLM_MODEL=gpt-4o
EVAL_LLM_BINDING_API_KEY=your-openai-api-key-here
# EVAL_LLM_BINDING_HOST=http://localhost:8000/v1  # 可选

# RAGAS评估使用的Embedding
EVAL_EMBEDDING_MODEL=text-embedding-3-large
EVAL_EMBEDDING_BINDING_API_KEY=your-openai-api-key-here
# EVAL_EMBEDDING_BINDING_HOST=http://localhost:8000/v1  # 可选

# 评估参数
EVAL_LLM_MAX_RETRIES=5
EVAL_LLM_TIMEOUT=180

# ============================================================================
# LightRAG工作目录配置
# ============================================================================

WORKING_DIR=./rag_storage_bk100_baseline
INPUT_DIR=./inputs

# ============================================================================
# 检索配置调优参数
# ============================================================================

# Chunk大小配置（影响检索粒度）
# CHUNK_TOKEN_SIZE=1200
# CHUNK_OVERLAP_TOKEN_SIZE=100

# 检索数量配置
# TOP_K=10

# 相似度阈值
# COSINE_THRESHOLD=0.2

# ============================================================================
# 存储后端配置（可选）
# ============================================================================

# 默认使用本地NanoVectorDB，如需使用其他向量数据库：

# Milvus配置
# VECTOR_DB=milvus
# MILVUS_URI=http://localhost:19530
# MILVUS_COLLECTION_NAME=lightrag_bk100

# Qdrant配置
# VECTOR_DB=qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION_NAME=lightrag_bk100

# PostgreSQL配置
# VECTOR_DB=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DATABASE=lightrag

# ============================================================================
# 图数据库配置（可选）
# ============================================================================

# Neo4j配置
# GRAPH_DB=neo4j
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password

# ============================================================================
# API服务配置
# ============================================================================

# LightRAG API端口
PORT=9621
HOST=0.0.0.0

# API认证（可选）
# API_KEY=your-api-key-for-authentication

# ============================================================================
# 日志配置
# ============================================================================

LOG_LEVEL=INFO
LOG_FILE=lightrag_bk100.log

# ============================================================================
# 高级配置（可选）
# ============================================================================

# 启用重排序（需要安装reranker）
# ENABLE_RERANK=true
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 并发控制
# MAX_ASYNC=10
# MAX_TOKENS=4000

# 缓存配置
# ENABLE_LLM_CACHE=true
# CACHE_TYPE=redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
